# Basic Config
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://neondb_owner:your_password_here@ep-rough-snow-axs48dt5-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://neondb_owner:your_password_here@ep-rough-snow-axs48dt5-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"
